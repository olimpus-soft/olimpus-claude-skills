# ── Aplicación ────────────────────────────────────────────────────────────────
APP_ENV=development
APP_PORT=8000
APP_DEBUG=true
LOG_LEVEL=DEBUG
COMPOSE_PROJECT_NAME=myapp

# ── Base de datos ─────────────────────────────────────────────────────────────
POSTGRES_USER=dev_user
POSTGRES_PASSWORD=dev_pass
POSTGRES_DB=myapp_dev
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://dev_user:dev_pass@localhost:5432/myapp_dev

# ── Cache ─────────────────────────────────────────────────────────────────────
REDIS_PORT=6379
REDIS_PASSWORD=changeme
REDIS_URL=redis://:changeme@localhost:6379/0

# ── Seguridad ─────────────────────────────────────────────────────────────────
INTERNAL_SECRET=change-this-to-a-random-secret-in-production

# ── TODO: Agregar variables específicas del stack y dominio ───────────────────
